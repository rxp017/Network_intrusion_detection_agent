# ==============================================================================
# NIDA Configuration
# ==============================================================================
# To use: copy this file to `.env` in the project root:
#   cp .env.example .env   (or Copy-Item .env.example .env in PowerShell)
#
# By default, NIDA runs 100% offline with zero outbound network requests.
# When you paste your API keys below, the on-demand "✦ Explain in plain English"
# button will automatically generate non-technical briefings.

# ------------------------------------------------------------------------------
# 1. API Keys (Paste either or both)
# ------------------------------------------------------------------------------
# Groq API Key (Fastest: ~300ms latency. Free tier available at https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini API Key (High capability. Free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Waterfall & Provider Selection
# ------------------------------------------------------------------------------
# Options:
#   waterfall - (RECOMMENDED) If both keys are set, tries Groq first for blazing speed.
#               If Groq hits a rate limit (HTTP 429), quota exhaustion, or error,
#               it automatically and seamlessly fails over to Gemini!
#   groq      - Uses Groq (falls back to Gemini only if Groq fails and GEMINI_API_KEY is present).
#   gemini    - Uses Gemini (falls back to Groq only if Gemini fails and GROQ_API_KEY is present).
#   none      - Disables all external LLM calls (100% offline local model inference).
LLM_PROVIDER=waterfall

# ------------------------------------------------------------------------------
# 3. Model Overrides (Optional - sensible defaults are pre-configured)
# ------------------------------------------------------------------------------
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Server Configuration (Optional)
# ------------------------------------------------------------------------------
# NIDA_HOST=127.0.0.1
# NIDA_PORT=8000
